# Copie para .env e preencha. O .env real NUNCA vai para o repositorio
# (esta no .gitignore) — nao remova essa linha de la.
#
# Chaves separadas por rede, sem fallback entre elas: um erro de variavel
# trava a execucao em vez de trocar de conta.

# Conta descartavel, so testnet. USDC gratis em https://faucet.circle.com
# (selecione "Arc Testnet"; 20 USDC, 1 pedido por 2h).
PRIVATE_KEY_TESTNET=0x

# Conta com USDC de verdade na Arc mainnet. Conta NOVA, so para isso.
PRIVATE_KEY_MAINNET=0x

# Opcional: conta descartavel que representa o PROVEDOR nos testes. Fixa
# entre rodadas para o saldo de gas persistir. Gere uma chave qualquer e
# nova — a Arc blocklista as chaves famosas do Hardhat/Anvil e a RPC
# recusa ate estimateGas ("Blocked address").
PROVIDER_KEY_TESTNET=0x
